yNl=explain_nl(c,ds),hook=c['hook'],kind='standard'))

# Add some carefully authored LO7 list/negative questions.
lo7_manual=[
("Which TWO statements about incident management are correct?\n1. Its immediate focus is restoring normal service operation.\n2. Every incident must remain open until the underlying problem is permanently removed.\n3. A workaround can be used to reduce impact before a permanent fix exists.\n4. It is primarily responsible for authorizing normal changes.",["1 and 3","1 and 2","2 and 4","3 and 4"],"Incident management focuses on restoration and can use workarounds. Permanent cause removal belongs primarily to problem management; change authorization belongs to change enablement.","1 en 3 zijn juist. Incident management draait om herstel en mag een workaround gebruiken; structurele oorzaakanalyse hoort bij problem management.","Restore first; root cause can follow.",'Incident management','list'),
("Which action is NOT consistent with service request management?",["Treating every predefined request as an incident because a user contacted support","Using agreed request models for frequently requested actions","Obtaining approval when the predefined workflow requires it","Automating suitable fulfilment steps for common requests"],"A service request is not automatically an incident. Requests are predefined user-initiated actions in normal service delivery and may include approval or automation.","Een vooraf gedefinieerd verzoek wordt niet automatisch een incident. Goedkeuring en automatisering kunnen gewoon onderdeel van het requestmodel zijn.","Request ≠ incident.",'Service request management','negative'),
("Which TWO statements about standard changes are correct?\n1. They are low risk and well understood.\n2. They are always emergency changes performed frequently.\n3. Their authorization is already in place under an agreed model.\n4. They never require documentation.",["1 and 3","1 and 2","2 and 4","3 and 4"],"Standard changes are low risk, well understood, documented and pre-authorized under an agreed model.","1 en 3 zijn juist. Standard changes zijn laag risico, goed begrepen, gedocumenteerd en vooraf geautoriseerd.","Standard = pre-authorized model.",'Change enablement','list'),
("Which statement about an emergency change is CORRECT?",["It uses an expedited assessment and authorization path because implementation is needed as soon as possible","It requires no authorization because urgency overrides governance","It is any change requested by a senior manager","It is always a standard change performed outside business hours"],"Emergency changes are expedited, not uncontrolled. Appropriate assessment and authorization still apply.","Emergency betekent versneld, niet ongecontroleerd. Passende beoordeling en autorisatie blijven nodig.","Urgent still means authorized.",'Change enablement','standard'),
("Which TWO statements about problem management are correct?\n1. It can identify problems proactively from trends and vulnerabilities.\n2. A known error is always a problem that has already been permanently resolved.\n3. Error control can manage known errors and available workarounds.\n4. Its primary purpose is to restore every incident as quickly as possible.",["1 and 3","1 and 2","2 and 4","3 and 4"],"Problem management includes proactive identification and management of known errors. A known error is analysed but unresolved; rapid restoration is incident management's focus.","1 en 3 zijn juist. Known error betekent geanalyseerd maar nog niet opgelost. Snel herstellen is primair incident management.","Problem = causes; incident = restoration.",'Problem management','list'),
("Which action BEST reflects the service desk practice?",["Provide a clear user contact point, capture relevant demand and maintain useful communication while specialist teams may resolve the technical issue","Perform every technical resolution personally so users never interact with another team","Authorize all service changes before they are scheduled","Set supplier contracts and penalties for all external providers"],"The service desk is the users' entry point and communication interface. It does not have to personally perform every specialist resolution.","De service desk is het centrale contactpunt en bewaakt goede communicatie. Specialistische teams kunnen de technische oplossing uitvoeren.","Contact and communication, not every technical fix.",'Service desk','standard'),
("Which TWO statements about service level management are correct?\n1. Targets should be based on business needs and meaningful service outcomes.\n2. Component metrics alone always prove that users receive good service.\n3. Service performance should be reviewed against agreed targets.\n4. Service level management is primarily responsible for diagnosing recurring incident causes.",["1 and 3","1 and 2","2 and 4","3 and 4"],"Service level management agrees meaningful targets and reviews service delivery against them. Component-only metrics can miss poor user experience; recurring cause analysis belongs to problem management.","1 en 3 zijn juist. Alleen technische componentmetingen kunnen slechte gebruikerservaring verbergen. Oorzaakanalyse hoort bij problem management.","Business-based targets + review.",'Service level management','list'),
]
for p,opts,en,nl,hook,tag,kind in lo7_manual:
    add(dict(id=qid('7.1'),criterion='7.1',lo=7,tag=tag,prompt=p,options=opts,why=en,whyNl=nl,hook=hook,kind=kind))

# Generic generation to hit target counts. Criteria map to concepts; LO7 gets deep practice concepts too.
crit_ids={k:list(v) for k,v in GROUPS.items() if k in TARGET}
crit_ids['7.1']=GROUPS['7.1']
# For 2.1 and 5.1 only manual content is used; if short, duplicate-free variants are added below.

# Ensure enough natural variants per concept. Cycle variants, then add contextual wrappers if needed.
for crit,target in TARGET.items():
    if crit in ('2.1','5.1'): continue
    ids=crit_ids.get(crit,[])
    if not ids: continue
    round_no=0
    attempts=0
    while sum(q['criterion']==crit for q in questions)<target and attempts<5000:
        cid=ids[round_no%len(ids)]; c=C[cid]
        variant=(round_no//len(ids))%7
        q=gen_for_concept(c,crit,variant)
        if q:
            # If the standard generated wording collides, add a small context-neutral lead-in while keeping meaning.
            if not add(q):
                q=dict(q); q['id']=qid(crit)
                lead=['In an ITIL 4 context, ','For service management, ','When distinguishing similar concepts, '][(round_no//(len(ids)*7))%3]
                q['prompt']=lead+q['prompt'][0].lower()+q['prompt'][1:]
                add(q)
        round_no+=1; attempts+=1
    if sum(q['criterion']==crit for q in questions)<target:
        raise RuntimeError(f'could not fill {crit}: {sum(q["criterion"]==crit for q in questions)}/{target}')

