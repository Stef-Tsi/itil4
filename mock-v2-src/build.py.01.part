# English descriptions for deeper LO7 scenarios beyond simple purpose recall.
DEEP_CLUES={
'improvement-practice':[
 'A team repeatedly checks where its services and practices could better support changing business needs and records opportunities for action.',
 'Improvement work is treated as an ongoing responsibility rather than a one-off project owned by a specialist team.',
 'A team uses a structured model to move from a shared vision and baseline to action, evaluation and sustained momentum.'
],
'change-practice':[
 'A proposed modification is assessed for risk and then sent to the appropriate authority before implementation is scheduled.',
 'Different change models use different authorities, and the schedule is used to help avoid conflicts between planned changes.',
 'The organization aims to increase the number of successful service changes while balancing risk and speed.'
],
'incident-practice':[
 'A user-facing service is degraded, so the immediate priority is to restore normal operation and reduce business impact.',
 'A support team applies a temporary workaround so users can resume work before the underlying cause is removed.',
 'Several specialists collaborate quickly on a high-impact interruption instead of waiting for one tier to finish before involving the next.'
],
'problem-practice':[
 'Repeated incidents are analysed to identify and control their underlying or potential causes.',
 'An analysed but unresolved defect is documented so future incidents can be diagnosed and managed more effectively.',
 'Trend analysis is used proactively to identify conditions that could cause incidents before a major interruption occurs.'
],
'request-practice':[
 'A user asks for a predefined service action that belongs to normal service delivery and follows an agreed fulfilment workflow.',
 'A routine access request may still require an approval step even though it is not an incident or a normal change.',
 'Frequently requested service actions are standardized and automated where appropriate to make fulfilment effective and user-friendly.'
],
'desk-practice':[
 'Users need one clear entry point for incidents and service requests, with useful communication throughout the interaction.',
 'A support contact listens to the user, captures context and coordinates with a specialist team rather than personally fixing every technical issue.',
 'The quality of the user interaction depends on communication and empathy as well as technical knowledge.'
],
'level-practice':[
 'A provider agrees business-based targets with a customer and reviews whether the end-to-end service is meeting them.',
 'Technical component metrics look healthy, but users report poor service; the team therefore adds measures that reflect user experience.',
 'Targets and measures are expressed in terms meaningful to the customer rather than only in infrastructure statistics.'
]
}

# Additional accurate detail cues for specific LO7 terms.
TERM_CLUES={
'request':['The user initiates an agreed, predefined service action and no service failure has occurred.','The demand belongs to normal service delivery and follows a known request model.'],
'workaround':['The action reduces the impact of an incident or problem without removing the underlying cause.','Service can continue using an alternative method while a complete resolution is still unavailable.'],
'standard':['The change is low-risk, well understood, documented and already authorized under an agreed model.','No new authorization is needed each time because the approved procedure is followed exactly.'],
'normal':['The change is not covered by a pre-authorized model and therefore needs assessment and authorization appropriate to its risk.','The proposed modification is planned through the normal change process rather than an expedited emergency path.'],
