(()=>{'use strict';
const app=document.getElementById('app'),D=window.MOCK_DATA;if(!D||!D.questions){app.innerHTML='<section class="card"><h1>Question bank unavailable</h1></section>';return}
const BP=D.blueprint, PASS=26, KEY='itil4-mock-calibrated-v2';
const LO={1:'Key concepts',2:'Guiding principles',3:'Four dimensions',4:'Service value system',5:'Service value chain',6:'Practice purposes & key terms',7:'Seven practices in detail'};
const B=new Map(D.questions.map(q=>[q.id,q]));
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const sh=a=>{a=[...a];for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
const empty=()=>({v:2,count:3,topic:'practices',examSeen:{},focusSeen:{},records:{},history:[],current:null});let P=empty(),timer=null,review=[],rp=0;
try{let x=JSON.parse(localStorage.getItem(KEY)||'null');if(x&&x.v===2)P={...empty(),...x}}catch{}
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(P))}catch{}};
const btn=(t,a,p=false,attrs='')=>`<button data-act="${a}" class="${p?'primary':''}" ${attrs}>${t}</button>`;
function show(x){app.innerHTML=x;window.scrollTo(0,0);app.querySelector('h1')?.focus({preventScroll:true})}
function footer(){return `<p class="notice">Independent ITIL 4 practice. Original questions, not copied from PeopleCert. The full mock follows the published ITIL 4 Foundation learning-outcome weighting and the 9 recall / 31 understanding split. Difficulty cannot be proven identical to a live exam. Progress stays in this browser. Build ${esc(D.version)}.</p>`}
function seenCount(m){return Object.values(m||{}).filter(v=>v>0).length}
function home(){stopTimer();let s=P.current;show(`<header class="intro"><span class="kicker">ITIL 4 · CALIBRATED UPDATE</span><h1 tabindex="-1">Train the wording.<br>Learn the difference.</h1><p class="muted">Built around the question types you met in the official mock: short definitions, BEST/MOST, MAIN/PRIMARY, NOT, missing-word and statement-pair questions.</p></header><section class="card"><div class="facts"><div class="fact"><b>${D.meta.questionCount}</b><span>unique questions</span></div><div class="fact"><b>${D.meta.nonRepeatingFullMockCapacity}</b><span>full mocks before forced repeats</span></div><div class="fact"><b>9 / 31</b><span>recall / understanding per paper</span></div><div class="fact"><b>26 / 40</b><span>practice pass mark</span></div></div><p class="bank-note">The bank uses related distractors so you must distinguish concepts instead of spotting an off-topic answer.</p></section>${s&&!s.done?`<section class="card"><span class="kicker">PAUSED</span><h2>${s.mode==='exam'?'Full mock':'Focus block'}</h2><p>Question ${s.index+1} of ${s.items.length}</p>${btn('Resume','resume',true)}${s.mode==='exam'?'<p class="small">The deadline keeps running.</p>':''}</section>`:''}<section class="card"><span class="kicker">FOCUS MODE · NO TIMER</span><h2>Choose a small block</h2><div class="choices">${[1,3,5,10,20].map(n=>btn(String(n),'preset',false,`data-count="${n}" aria-pressed="${P.count===n}"`)).join('')}</div><div class="fields"><label>Questions per block<input id="count" type="number" min="1" max="40" inputmode="numeric" value="${P.count}"></label><label>Topic<select id="topic"><option value="all">All topics</option><option value="practices">Practices · LO6 + LO7</option>${Object.entries(LO).map(([n,t])=>`<option value="${n}">LO${n} · ${esc(t)}</option>`).join('')}</select></label></div><button class="primary full" data-act="start-focus">Start focus block</button><p class="small">Unseen questions first. Feedback: English explanation, memory cue, expanded reading strategy, optional Dutch help.</p></section><section class="card"><span class="kicker">FULL MOCK</span><h2>40 questions · 60 minutes</h2><p>No hints or feedback before submission. Change answers, flag questions and use the navigator.</p><button class="primary full" data-act="start-exam">Start full mock</button><p class="small">Focus history and full-mock history are separate, so Focus practice does not use up unseen mock questions.</p></section><section class="card"><span class="kicker">HISTORY</span><p><b>Full-mock questions seen:</b> ${seenCount(P.examSeen)}/${D.meta.questionCount}<br><b>Focus questions seen:</b> ${seenCount(P.focusSeen)}/${D.meta.questionCount}</p>${P.history.length?`<div class="history">${P.history.slice(-5).reverse().map(h=>`<div class="history-row"><span>${h.mode==='exam'?'Mock':'Focus'} · ${new Date(h.date).toLocaleDateString()}</span><b>${h.score}/${h.total}</b></div>`).join('')}</div>`:''}<div class="actions">${btn('Reset history','reset')}</div></section>${footer()}`);document.getElementById('topic').value=P.topic}
function pool(topic){return D.questions.filter(q=>topic==='all'||(topic==='practices'?(q.lo===6||q.lo===7):String(q.lo)===String(topic)))}
function leastSeen(list,map){return sh(list).sort((a,b)=>(map[a.id]||0)-(map[b.id]||0)||(P.records[a.id]?.last||0)-(P.records[b.id]?.last||0))}
function focusPaper(n,topic){let x=pool(topic);if(!Number.isInteger(n)||n<1||n>40)throw Error('Choose 1–40 questions.');if(n>x.length)throw Error(`Only ${x.length} questions exist for this topic.`);return leastSeen(x,P.focusSeen).slice(0,n)}
function examPaper(){let out=[];for(const [c,n] of Object.entries(BP)){let x=D.questions.filter(q=>q.criterion===c);out.push(...leastSeen(x,P.examSeen).slice(0,n))}return sh(out)}
const items=qs=>qs.map(q=>({id:q.id,order:sh([0,1,2,3]),choice:null,checked:false,flag:false}));
function replaceOK(){return !P.current||P.current.done||confirm('Replace the unfinished session? Completed history stays saved.')}
function startFocus(){try{let n=Number(document.getElementById('count').value),t=document.getElementById('topic').value;if(!replaceOK())return;P.count=n;P.topic=t;P.current={mode:'focus',items:items(focusPaper(n,t)),index:0,done:false};save();question()}catch(e){alert(e.message)}}
function startExam(){if(!replaceOK())return;P.current={mode:'exam',items:items(examPaper()),index:0,done:false,deadline:Date.now()+3600000};save();question()}
function left(){return Math.max(0,Math.ceil(((P.current?.deadline||0)-Date.now())/1000))}function fmt(s){return `${Math.floor(s/60).toString().padStart(2,'0')}:${(s%60).toString().padStart(2,'0')}`}
function stopTimer(){if(timer)clearInterval(timer);timer=null}function startTimer(){stopTimer();if(P.current?.mode==='exam'&&!P.current.done)timer=setInterval(()=>{if(left()<=0)return finish(true);let e=document.getElementById('timer');if(e){e.textContent=fmt(left());e.classList.toggle('urgent',left()<=300)}},1000)}
function hi(s){return esc(s).replace(/\b(NOT|EXCEPT|BEST|MOST|PRIMARY|MAIN|FIRST|NEXT|TWO|CORRECT)\b/g,'<strong class="operator">$1</strong>')}
function question(){let s=P.current;if(!s||s.done)return home();if(s.mode==='exam'&&left()<=0)return finish(true);let it=s.items[s.index],q=B.get(it.id),f=s.mode==='focus';show(`<header class="row